{
  "name": "csgogamble-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "tsc --noEmit && biome check .",
    "duplicate-check": "jscpd --config .jscpd.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill": "tsx scripts/backfill.ts",
    "backfill:daemon": "tsx scripts/backfill-daemon.ts",
    "canary:acquisition": "tsx scripts/acquisition-canary.ts",
    "reparse:raw-html": "tsx scripts/reparse-raw-html.ts",
    "health:ingest": "tsx scripts/ingestion-health.ts",
    "ops:preflight": "npm run health:ingest -- --strict --samples 10",
    "ops:canary": "npm run backfill:daemon -- --apply --filter partial --max 50 --batch-size 10 --concurrency 1 --acquisition-mode http-stealth",
    "ops:resume": "npm run backfill:daemon -- --apply --resume",
    "ops:verify": "npm run health:ingest -- --strict --samples 20",
    "ops:close-stale-runs": "tsx scripts/close-stale-runs.ts",
    "benchmark:cloudflare": "tsx scripts/benchmark-cloudflare-browser.ts",
    "download-demo": "tsx scripts/download-demo.ts",
    "polymarket:canary": "tsx scripts/polymarket-canary.ts",
    "polymarket:worker": "tsx scripts/polymarket-worker-run.ts",
    "health:polymarket": "tsx scripts/polymarket-health.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/vitest-pool-workers": "^0.8.44",
    "@cloudflare/workers-types": "^4.20260405.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.6.0",
    "jscpd": "^4.2.3",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "wrangler": "^4.81.1"
  }
}
